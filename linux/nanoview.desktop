[Desktop Entry]
Type=Application
Name=nanoview
GenericName=Image Viewer
Comment=A small, fast image viewer
Exec=nanoview %f
Icon=nanoview
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/tiff;image/webp;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/qoi;
StartupWMClass=nanoview
